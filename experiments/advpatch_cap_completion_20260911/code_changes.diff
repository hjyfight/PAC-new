+    def advpatch_loss(self, images):
+        """Mean per-image peak person confidence, matching the selected AdvPatch run.
+
+        YOLO uses objectness times person probability. Faster R-CNN has no
+        equivalent objectness output: use pre-NMS ROI softmax person scores,
+        split by each image's proposal count before taking the maximum.
+        """
+        if self.name != "fasterrcnn":
+            return attack_loss(self(images))
+        counts = []
+
+        def capture_counts(module, inputs):
+            counts.extend(len(proposals) for proposals in inputs[1])
+
+        handle = self.detector.roi_heads.register_forward_pre_hook(capture_counts)
+        try:
+            self(images)
+            scores = self.roi_logits.softmax(-1)[:, 1]
+            return torch.stack([values.max() if values.numel() else values.sum()
+                                for values in scores.split(counts)]).mean()
+        finally:
+            handle.remove()
+            self.roi_logits = None
